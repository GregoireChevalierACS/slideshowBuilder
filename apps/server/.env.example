# Modèle de configuration : copier en .env (non versionné) et adapter.
# Le serveur écoute toujours sur 127.0.0.1 : l'adresse n'est pas configurable.

# Port HTTP (entier entre 1 et 65535)
PORT=4321

# Fichier SQLite des diagnostics (créé au premier démarrage, dossiers compris)
CHEMIN_DE_LA_BASE=data/diagnostics.sqlite
