{
  "name": "@slideshow/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slideshow/domain": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "tsdown": "0.23.2",
    "vitest": "4.1.12"
  }
}
